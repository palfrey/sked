{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    "security:only-security-updates",
  ],
  packageRules: [
    {
      matchPackageNames: ["*"],
      automerge: true
    },
  ],
}
